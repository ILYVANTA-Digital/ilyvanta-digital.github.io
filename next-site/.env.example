# Canonical public origin; keep existing URL until approved cutover.
SITE_URL=https://ilyvanta-digital.umarilyas.chatgpt.site
# Preview default stays noindex. Enable only for reviewed production.
SITE_INDEXABLE=false
# Phase 2: server-only, not configured yet.
DATABASE_URL=
RESEND_API_KEY=
CONTACT_FROM=
# Phase 4: blocked pending secure credential setup:
OPENAI_API_KEY=
# Optional analytics: disabled until a real property and consent QA are ready.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
ANALYTICS_ENABLED=false
# Form is fail-closed until all providers and the migration are verified.
CONTACT_ENABLED=false
# Server-only random value; generate at least 32 random bytes outside source control.
RATE_LIMIT_SECRET=
# Select netlify only after form detection and notifications are configured.
# The database/Resend transport remains the default when this is unset.
CONTACT_PROVIDER=database
